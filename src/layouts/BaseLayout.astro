---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description = "Aprenda sobre marketing de afiliados, conheça plataformas, estratégias de divulgação, ferramentas e análises de produtos digitais no Blog Radar F5.",
  canonical,
  image,
  type = "website",
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
// Usa a imagem realmente cadastrada, sem presumir uma versão JPG.
const ogImage = image;
const imageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Título e SEO Principal -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Redes Sociais -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Radar F5" />

    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:secure_url" content={imageUrl} />

        </>
      )
    }

    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    {
      import.meta.env.ADS_ENABLED === "true" && import.meta.env.ADSENSE_CLIENT_ID && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.ADSENSE_CLIENT_ID}`}
          crossorigin="anonymous"
        ></script>
      )
    }

    <slot name="head" />
  </head>

  <body>
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
