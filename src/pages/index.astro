---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CategoryNav from "../components/CategoryNav.astro";

const articles = (await getCollection("articles", ({ data }) => {
  return data.draft !== true;
})).sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<BaseLayout
  title="Radar F5 | Marketing de Afiliados, Ferramentas e Reviews"
  description="Aprenda sobre marketing de afiliados, conheça plataformas, estratégias de divulgação, ferramentas e análises de produtos digitais no Blog Radar F5."
>
  <section class="container hero-section">
    <div class="callout-box">
      <h1>Marketing de Afiliados e Negócios Digitais</h1>

      <p>
        Bem-vindo(a) ao <strong>Radar F5</strong>.
      </p>

      <p>
        Aprenda sobre marketing de afiliados, conheça as principais plataformas, descubra ferramentas e estratégias de divulgação e encontre análises de produtos digitais para tomar decisões mais informadas.
      </p>
    </div>
  </section>

  <section class="container articles-grid">
    <CategoryNav />

    <h2>Artigos em Destaque</h2>

    {
      articles.length === 0 ? (
        <p class="empty-state">
          Estamos preparando os primeiros conteúdos sobre marketing de afiliados. Volte em breve!
        </p>
      ) : (
        articles.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            category={article.data.category}
            image={article.data.image}
            imageAlt={article.data.imageAlt}
            href={`/artigos/${article.data.slug}/`}
          />
        ))
      )
    }
  </section>
</BaseLayout>
